	"item": [
		{
			"name": "Create User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var random=Math.random().toString(36).substring(2);\r",
							"\r",
							"var usermail=\"jim\"+random+\"@gmail.com\";\r",
							"var username=\"jim\"+random;\r",
							"\r",
							"pm.environment.set(\"email_env\",usermail);\r",
							"pm.environment.set(\"name_env\",username);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData=JSON.parse(responseBody);\r",
							"pm.environment.set(\"userid_env\",jsonData.id);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"name\":\"{{name_env}}\",\r\n\"gender\":\"male\",\r\n\"email\":\"{{email_env}}\",\r\n\"status\":\"inactive\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url_gorest}}/public/v2/users",
